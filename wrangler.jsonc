{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setsutore",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setsutore",
      // 自分の Cloudflare に置くときは、wrangler d1 create setsutore で出た database_id に置き換える
      "database_id": "d5eb0544-2919-4228-b8bf-aaba1297f860",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "setsutore-photos"
    }
  ],
  "vars": {
    "AI_DAILY_LIMIT": "200"
  }
}
