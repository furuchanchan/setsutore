{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setsutore",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setsutore",
      // wrangler d1 create setsutore で出た database_id に置き換える
      "database_id": "REPLACE_ME",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "setsutore-photos"
    }
  ],
  "vars": {
    "AI_DAILY_LIMIT": "200"
  }
}
